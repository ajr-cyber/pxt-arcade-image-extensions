<xml xmlns="https://developers.google.com/blockly/xml"><variables></variables><block type="pxt-on-start" id="5*7QKO,-SzW~N.J?MS)0" x="0" y="0"><statement name="HANDLER"><block type="typescript_statement" id="jP(2kYT4*$e(nY(;TR%:"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="namespace images {" line1="" line2="    /**" line3="     * Rotates an image 90 degrees clockwise and returns the new rotated image." line4="     * @param img The source image to rotate" line5="     */" line6="    //% blockId=&quot;images_rotate_90_clockwise&quot;" line7="    //% block=&quot;rotate $img 90° clockwise&quot;" line8="    //% img.shadow=image_picker" line9="    export function rotate90Clockwise(img: Image): Image {" line10="        if (!img) return null;" line11="" line12="        // 1. Get original dimensions" line13="        let oldWidth = img.width;" line14="        let oldHeight = img.height;" line15="" line16="        // 2. Create a new blank image with flipped dimensions" line17="        // (A 16x8 image becomes 8x16)" line18="        let rotatedImg = image.create(oldHeight, oldWidth);" line19="" line20="        // 3. Map old pixel coordinates to new rotated coordinates" line21="        for (let srcX = 0; srcX &lt; oldWidth; srcX++) {" line22="            for (let srcY = 0; srcY &lt; oldHeight; srcY++) {" line23="                // Get the pixel color from original image" line24="                let color = img.getPixel(srcX, srcY);" line25="" line26="                // Calculate new position for 90-degree clockwise shift" line27="                let destX = (oldHeight - 1) - srcY;" line28="                let destY = srcX;" line29="" line30="                // Write to the new image canvas" line31="                rotatedImg.setPixel(destX, destY, color);" line32="            }" line33="        }" line34="" line35="        return rotatedImg;" line36="    }" line37="" line38="    /**" line39="     * Takes an array of images, rotates each one 90 degrees clockwise, " line40="     * and returns a new array containing the rotated images." line41="     * @param list The array of images to rotate" line42="     */" line43="    //% blockId=&quot;images_rotate_array_90_clockwise&quot;" line44="    //% block=&quot;rotate image array $list 90° clockwise&quot;" line45="    //% list.shadow=variables_get" line46="    export function rotateImageArray90Clockwise(list: Image[]): Image[] {" line47="        // 1. Safety check: if the array doesn't exist, return an empty array" line48="        if (!list) return [];" line49="" line50="        // 2. Create a fresh, empty array to hold our new images" line51="        let rotatedList: Image[] = [];" line52="" line53="        // 3. Loop through every image in the original array" line54="        for (let i = 0; i &lt; list.length; i++) {" line55="            let currentImg = list[i];" line56="" line57="            // Re-use your existing rotation logic for individual images" line58="            let rotatedImg2 = rotate90Clockwise(currentImg);" line59="" line60="            // Push the newly created image into our output array" line61="            if (rotatedImg2) {" line62="                rotatedList.push(rotatedImg2);" line63="            }" line64="        }" line65="" line66="        // 4. Return the completed list of rotated images" line67="        return rotatedList;" line68="    }" line69="" line70="}" numlines="71"></mutation></block></statement></block></xml>