<xml xmlns="https://developers.google.com/blockly/xml"><variables></variables><block type="pxt-on-start" id=")Iq:Z:Lc:ia!8W}|jG3/" x="0" y="0"><statement name="HANDLER"><block type="typescript_statement" id="lEK/WP#YR74?I-:|dd~."><mutation xmlns="http://www.w3.org/1999/xhtml" line0="namespace images {" line1="" line2="    /**" line3="     * Rotates an image 90 degrees clockwise and returns the new rotated image." line4="     * @param img The source image to rotate" line5="     */" line6="    //% blockId=&quot;images_rotate_90_clockwise&quot;" line7="    //% block=&quot;rotate $img 90° clockwise&quot;" line8="    //% img.shadow=image_picker" line9="    export function rotate90Clockwise(img: Image): Image {" line10="        if (!img) return null;" line11="" line12="        // 1. Get original dimensions" line13="        let oldWidth = img.width;" line14="        let oldHeight = img.height;" line15="" line16="        // 2. Create a new blank image with flipped dimensions" line17="        // (A 16x8 image becomes 8x16)" line18="        let rotatedImg = image.create(oldHeight, oldWidth);" line19="" line20="        // 3. Map old pixel coordinates to new rotated coordinates" line21="        for (let srcX = 0; srcX &lt; oldWidth; srcX++) {" line22="            for (let srcY = 0; srcY &lt; oldHeight; srcY++) {" line23="                // Get the pixel color from original image" line24="                let color = img.getPixel(srcX, srcY);" line25="" line26="                // Calculate new position for 90-degree clockwise shift" line27="                let destX = (oldHeight - 1) - srcY;" line28="                let destY = srcX;" line29="" line30="                // Write to the new image canvas" line31="                rotatedImg.setPixel(destX, destY, color);" line32="            }" line33="        }" line34="" line35="        return rotatedImg;" line36="    }" line37="}" numlines="38"></mutation></block></statement></block></xml>